<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="robot_type" default="$(eval open('/tmp/robot_type.yaml').read().split(':')[1].strip())"/>
  <arg name="estimator" default="kinematic_estimator_params"/>
  <arg name="controller_name" default="subscriber_controller"/>
  <arg name="controller_pkg_name" default="kangaroo_controller_configuration"/>
  <arg name="wbc_parameters" default=""/>
  <arg name="biped_parameters" default=""/>
  <arg name="estimator_parameters" default=""/>
  <arg name="local_joint_control_type" default="direct_impedance_control"/>
  <arg name="local_joint_control_leg_length" default="direct_impedance_control"/>
  <arg name="local_joint_control_ankle" default="direct_impedance_control"/>
  <arg name="local_joint_control_hip" default="direct_impedance_control"/>
  <arg name="local_joint_control_hip_z" default="direct_impedance_control"/>
  <arg name="local_joint_control_pelvis" default="direct_impedance_control"/>
  <arg name="local_joint_control_arms" default="direct_impedance_control"/>
  <arg name="local_joint_control_pkg" default="pal_local_joint_control"/>
  <arg name="safety_override" default=""/>
  <arg name="disable_safety_for_joints" default="['leg_left_4_joint','leg_left_5_joint','leg_right_4_joint','leg_right_5_joint']"/>
  <arg name="config_pkg" default="subscriber_controller"/>

  <rosparam command="delete" param="/$(arg controller_name)" />
  
  <rosparam command="load" file="$(find subscriber_controller)/config/kangaroo_subscriber_controller.yaml" />

  <rosparam command="load"
          file="$(eval find(arg('config_pkg')) + '/config/estimator/imu_parameters.yaml')" ns="$(arg controller_name)"/>

  <rosparam command="load"
      file="$(eval find(arg('config_pkg')) + '/config/imu.yaml')" ns="$(arg controller_name)"/>

  <rosparam command="load"
      file="$(eval find(arg('config_pkg')) + '/config/estimator/kinematic_estimator_params.yaml')" ns="$(arg controller_name)"/>

  <include file="$(find kangaroo_controller_configuration)/launch/local_joint_control/launcher.launch">
    <arg name="local_joint_control_type" value="$(arg local_joint_control_type)"/>
    <arg name="local_joint_control_pkg" value="$(arg local_joint_control_pkg)" />
    <arg name="ns" value="$(arg controller_name)"/>
    <arg name="safety_override" value="$(arg safety_override)"/>
    <arg name="disable_safety_for_joints" value="$(arg disable_safety_for_joints)"/>
    <arg name="local_joint_control_leg_length" default="$(arg local_joint_control_leg_length)"/>
    <arg name="local_joint_control_ankle" default="$(arg local_joint_control_ankle)"/>
    <arg name="local_joint_control_hip" default="$(arg local_joint_control_hip)"/>
    <arg name="local_joint_control_hip_z" default="$(arg local_joint_control_hip_z)"/>
    <arg name="local_joint_control_pelvis" default="$(arg local_joint_control_pelvis)"/>
    <arg name="local_joint_control_arms" default="$(arg local_joint_control_arms)"/>
  </include>

  <!-- Spawn controller -->
  <node name="subscriber_controller_spawner"
        pkg="controller_manager" type="spawner" output="screen"
        args="$(arg controller_name)" />

</launch>
