<launch>
  <!-- Move the config's joints to deployment_start_config.json with whole-tree gravity
       compensation on the waist and both arms. Run with the upper-body controllers running.
       The move ends by exiting, which stops the gravity bridge; the controller then holds the
       last compensated command until the policy takes over with its target_preload. -->
  <arg name="config" doc="Deployment config file: rosrun pal_policy_deployer task_config.py TASK prints its path." />
  <arg name="start_config_path" />
  <arg name="position_tolerance" default="0.05" />

  <node pkg="pal_gravity_compensation" type="gravity_compensation_node"
        name="gravity_compensation" output="screen" required="true">
    <rosparam command="load" file="$(find pal_policy_deployer)/config/gravity_compensation_upperbody.yaml" />
  </node>

  <node pkg="pal_policy_deployer" type="move_to_start_config.py"
        name="move_to_start_config" output="screen" required="true" clear_params="true">
    <rosparam command="load" file="$(arg config)" />
    <param name="start_config_path" value="$(arg start_config_path)" />
    <param name="position_tolerance" value="$(arg position_tolerance)" />
    <!-- The bridge adds the gravity torque, so command the start pose itself. -->
    <param name="command_topic" value="/pal_grasp/desired_state_uncompensated" />
    <param name="use_target_preload" value="false" />
    <!-- The jaws are commanded to the start opening but run their own position loop; in the
         simulator they stick near 0.086 and report a spurious velocity, so they are not
         required to settle. -->
    <rosparam param="unverified_joint_names">[gripper_left_finger_joint, gripper_right_finger_joint]</rosparam>
  </node>
</launch>
