<launch>
  <!-- Controllers for any grasp robot in config/robots/. PAL's subscriber controller starts with
       every joint in NoControl; spawn_grasp_controller.py then puts the robot's
       impedance_joint_names in direct_impedance_control with the env.yaml gains of the model, its
       position_joint_names (the jaws) in DirectPositionControl, and with gravity_compensation:
       true it runs the gravity bridge of the robot's gravity_compensation_config. -->
  <arg name="task" default="grasp-cube" doc="Task file in config/tasks/, for its robot and model." />
  <arg name="robot" default="" doc="Replaces the task's robot (a name in config/robots/ or a path)." />
  <arg name="config" default="" doc="A deployment config file instead of task and robot." />
  <arg name="reload_controller" default="false" doc="true restarts a subscriber_controller left running with other parameters; the arms drop while it restarts, so support them first." />
  <include file="$(find subscriber_controller)/launch/kangaroo_subscriber_controller.launch">
    <arg name="spawn_controller" value="false" />
    <arg name="local_joint_control_type" value="no_control" />
    <arg name="local_joint_control_leg_length" value="no_control" />
    <arg name="local_joint_control_ankle" value="no_control" />
    <arg name="local_joint_control_hip" value="no_control" />
    <arg name="local_joint_control_hip_z" value="no_control" />
    <arg name="local_joint_control_pelvis" value="no_control" />
    <arg name="local_joint_control_arms" value="no_control" />
  </include>

  <!-- Despite its name, direct_impedance_control is a joint PD computed in software and sent
       as effort: tau = K (q_des - q) + D (qd_des - qd) + tau_ff, with K and D the
       impedance_params stiffness_factor and damping_factor. See subscriber_controller/README.md. -->
  <node pkg="pal_policy_deployer" type="spawn_grasp_controller.py"
        name="spawn_grasp_controller" output="screen" required="true">
    <param name="task" value="$(arg task)" />
    <param name="robot" value="$(arg robot)" />
    <param name="config" value="$(arg config)" />
    <param name="reload" value="$(arg reload_controller)" />
  </node>
</launch>
