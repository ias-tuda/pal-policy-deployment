<launch>
  <!-- Controllers for the upper-body grasp policy: waist and both 7-DoF arms under
       direct_impedance_control with the training gains, both jaws under DirectPositionControl.
       The policy was trained without gravity feedforward, so no gravity bridge runs: the
       targets it sends carry the gravity load as PD error, as in simulation. -->
  <arg name="task" default="grasp-cube-upperbody" doc="Task file in config/tasks/, for its robot and model." />
  <arg name="robot" default="" doc="Replaces the task's robot (a name in config/robots/ or a path)." />
  <arg name="config" default="" doc="A deployment config file instead of task and robot." />
  <arg name="reload_controller" default="false" doc="true restarts a subscriber_controller left running with other parameters; the arm drops while it restarts, so support it first." />
  <include file="$(find subscriber_controller)/launch/kangaroo_subscriber_controller.launch">
    <arg name="spawn_controller" value="false" />
    <arg name="local_joint_control_type" value="no_control" />
    <arg name="local_joint_control_leg_length" value="no_control" />
    <arg name="local_joint_control_ankle" value="no_control" />
    <arg name="local_joint_control_hip" value="no_control" />
    <arg name="local_joint_control_hip_z" value="no_control" />
    <arg name="local_joint_control_pelvis" value="direct_impedance_control" />
    <arg name="local_joint_control_arms" value="no_control" />
  </include>

  <!-- Despite its name, direct_impedance_control is a joint PD computed in software and sent
       as effort: tau = K (q_des - q) + D (qd_des - qd) + tau_ff. spawn_grasp_controller.py
       overwrites K and D with the env.yaml gains of the robot's impedance_joint_names. -->
  <include file="$(find kangaroo_controller_configuration)/launch/local_joint_control/arm_left_7dof.launch">
    <arg name="local_joint_control_type" value="direct_impedance_control" />
    <arg name="local_joint_control_pkg" value="pal_local_joint_control" />
    <arg name="ns" value="subscriber_controller" />
  </include>
  <include file="$(find kangaroo_controller_configuration)/launch/local_joint_control/arm_right_7dof.launch">
    <arg name="local_joint_control_type" value="direct_impedance_control" />
    <arg name="local_joint_control_pkg" value="pal_local_joint_control" />
    <arg name="ns" value="subscriber_controller" />
  </include>

  <include file="$(find pal_local_joint_control)/launch/direct_position_control.launch">
    <arg name="joint_name" value="gripper_left_finger_joint" />
    <arg name="controller_pkg_name" value="pal_policy_deployer" />
    <arg name="ns" value="subscriber_controller" />
  </include>
  <include file="$(find pal_local_joint_control)/launch/direct_position_control.launch">
    <arg name="joint_name" value="gripper_right_finger_joint" />
    <arg name="controller_pkg_name" value="pal_policy_deployer" />
    <arg name="ns" value="subscriber_controller" />
  </include>

  <node pkg="pal_policy_deployer" type="spawn_grasp_controller.py"
        name="spawn_grasp_controller" output="screen" required="true">
    <param name="task" value="$(arg task)" />
    <param name="robot" value="$(arg robot)" />
    <param name="config" value="$(arg config)" />
    <param name="reload" value="$(arg reload_controller)" />
  </node>
</launch>
