<launch>
  <!-- Move the left arm and jaw to deployment_start_config.json with the gravity bridge, for a
       robot without gravity compensation (left_arm_nogravcomp), whose controllers run without
       the bridge. The move ends by exiting, which stops the bridge; the controller then holds
       the last compensated command until the policy takes over. -->
  <arg name="config" doc="Deployment config file: rosrun pal_policy_deployer task_config.py TASK prints its path." />
  <arg name="start_config_path" />
  <arg name="position_tolerance" default="0.1" />

  <include file="$(find pal_gravity_compensation)/launch/gravity_compensation.launch" />

  <node pkg="pal_policy_deployer" type="move_to_start_config.py"
        name="move_to_start_config" output="screen" required="true" clear_params="true">
    <rosparam command="load" file="$(arg config)" />
    <param name="start_config_path" value="$(arg start_config_path)" />
    <param name="position_tolerance" value="$(arg position_tolerance)" />
    <!-- The bridge adds the gravity torque, so command the start pose itself. -->
    <param name="command_topic" value="/pal_grasp/desired_state_uncompensated" />
    <param name="use_target_preload" value="false" />
  </node>
</launch>
