<launch>
  <!-- Start the grasp inferer without inference and check its first observation against
       start_observation_distribution.json beside the ONNX model. Run after
       move_to_start_config.py, with the grasp controllers still running. -->
  <arg name="profile" default="$(find pal_policy_deployer)/config/profiles/cube.yaml" />
  <arg name="joint_state_topic" default="" doc="Override the profile topic; empty uses the profile." />
  <arg name="start_config_path" default="" />
  <arg name="distribution_path" default="" />
  <arg name="tolerance" default="0.005" />
  <arg name="verbose" default="false" doc="Also print features that are inside the distribution." />

  <node pkg="pal_policy_inferer" type="pal_policy_inferer_mjlab_node"
        name="pal_policy_inferer_mjlab_node" output="screen" clear_params="true">
    <rosparam command="load" file="$(arg profile)" />
    <param name="task" value="grasp" />
    <param name="dry_run" value="true" />
    <param if="$(eval arg('joint_state_topic') != '')" name="joint_state_topic" value="$(arg joint_state_topic)" />
    <param if="$(eval arg('start_config_path') != '')" name="start_config_path" value="$(arg start_config_path)" />
  </node>

  <node pkg="pal_policy_deployer" type="check_start_distribution.py"
        name="check_start_distribution" output="screen" required="true">
    <param name="distribution_path" value="$(arg distribution_path)" />
    <param name="tolerance" value="$(arg tolerance)" />
    <param name="verbose" value="$(arg verbose)" />
  </node>
</launch>
