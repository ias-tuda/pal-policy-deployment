<launch>
  <!-- Argument for model version -->
  <arg name="model" default="v44" />
  <arg name="task" default="loco" />
  <arg name="fake_imu" default="false" doc="Use /base_imu_fake instead of /base_imu" />

  <node
    pkg="pal_policy_inferer"
    type="pal_policy_inferer_mjlab_node"
    name="pal_policy_inferer_mjlab_node"
    output="screen">
    <param name="model" value="$(arg model)" />
    <param name="task" value="$(arg task)" />
    <remap if="$(arg fake_imu)" from="/base_imu" to="/base_imu_fake" />
  </node>

  <node
    if="$(arg fake_imu)"
    pkg="pal_policy_preprocessor"
    type="base_imu_fix"
    name="base_imu_fix"
    output="screen">
    <param name="input_imu_topic" value="/base_imu" />
    <param name="output_imu_topic" value="/base_imu_fake" />
    <param name="use_odom_acceleration" value="false" />
  </node>
  
  <!-- <node 
    pkg="pal_policy_preprocessor" 
    type="joy_twist_accumulator" 
    name="joy_twist_accumulator" 
    output="screen"
  /> -->
  
  <!-- Bring up the subscriber controller -->
  <include file="$(find subscriber_controller)/launch/kangaroo_subscriber_controller.launch" />
</launch>
