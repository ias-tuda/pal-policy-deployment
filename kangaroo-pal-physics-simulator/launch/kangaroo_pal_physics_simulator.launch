<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- ARGUMENTS -->
  
  <!-- no-arm, 4dof, 5dof, 7dof] -->
  <arg name="arm_type" default="4dof" />
  <arg name="end_effector_type"   default="fake-forearm"/>

 <arg name="arm_type_processed" value="$(eval arg('arm_type') 
                if arg('arm_type')=='4dof' or (arg('arm_type')=='7dof' and arg('end_effector_type')=='no-end-effector')
                else arg('arm_type')+'_'+arg('end_effector_type'))" />

  <arg name="debug"         default="false"/>
  <arg name="valgrind"      default="false"/>
  <arg name="dt"            default="0.0005"/>
  <arg name="enable_crane"  default="false"/> 
  <arg name="simulation"    default="false"/>
  <arg name="fixed_base"    default="false"/>
  <arg name="ft_sensors"    default="false"/>
  <arg name="with_pelvis"   default="true"/>
  <arg name="with_arms"     default="true"/>
  <arg name="with_belt"     default="false" />
  <arg name="torso_2024"    default="false" />

  <arg name="world"         default=""/>
  <arg name="pids_type"     value="pids"               unless="$(arg fixed_base)"/>
  <arg name="pids_type"     value="pids_fixed_base"    if="$(arg fixed_base)"/>
  <arg name="gui" default="true"/>

  <!-- Load Kangaroo description with -->
  <include file="$(find kangaroo_description)/robots/upload.launch">
    <arg name="enable_crane"       value="$(arg enable_crane)"/> 
    <arg name="simulation"         value="$(arg simulation)"/> 
    <arg name="fixed_base"         value="$(arg fixed_base)"/> 
    <arg name="ft_sensors"         value="$(arg ft_sensors)"/> 
    <arg name="with_pelvis"        value="$(arg with_pelvis)"/>
    <arg name="with_arms"          value="$(arg with_arms)"/>
    <arg name="arm_type"           value="$(arg arm_type)"/>
    <arg name="end_effector_type"  value="$(arg end_effector_type)"/>
    <arg name="with_belt"          value="$(arg with_belt)"/>
    <arg name="torso_2024"         value="$(arg torso_2024)"/>
  </include>

  <!-- Load PIDs  && Load HAL description -->
  <include file="$(find kangaroo_pal_physics_simulator)/launch/kangaroo_pal_physics_simulator_parameters.launch">
    <arg name="pids"  value="$(arg pids_type)" />
    <arg name="ft_sensors"   value="$(arg ft_sensors)"/>
    <arg name="arm_type"     value="$(arg arm_type_processed)"/>
  </include>

  <!-- Launch simulation -->
  <include file="$(find pal_physics_simulator)/launch/pal_physics_simulator_parameters.launch">
    <arg name="fixed_base"  value="$(arg fixed_base)"/>
    <arg name="dt"          value="$(arg dt)"/>
    <arg name="type"        value="pal_physics_simulator::KangarooPhysicsSimulator"/>
  </include>

  <include file="$(find pal_physics_simulator)/launch/pal_physics_simulator.launch">
    <arg name="debug"           value="$(arg debug)"/>
    <arg name="valgrind"        value="$(arg valgrind)"/>
    <arg name="world_file_name" value="$(arg world)"/>
  </include>

  <!-- Spawn bringup controllers -->
  <include file="$(find kangaroo_bringup)/launch/kangaroo_bringup.launch">
    <arg name="ft_sensors"    value="$(arg ft_sensors)"/>
    <arg name="with_arms"     value="$(arg with_arms)"/>
    <arg name="arm_type"      value="$(arg arm_type_processed)"/>
    <arg name="with_pelvis"   value="$(arg with_pelvis)"/>
    <arg name="demo_mode"     value="false"/>
  </include>

  <node name="rviz" pkg="rviz" type="rviz" if="$(arg gui)" args="-d $(find kangaroo_pal_physics_simulator)/config/rviz/pal_physics_simulator.rviz" />

  <group if="$(arg enable_crane)">
    <rosparam ns="/simulator/parameters/">
      fixed_links:
        - link_id:
              id: 0
              name: "crane_link"
          type: 7
    </rosparam>
    <rosparam param="/default_floating_base_pose/position/">[0., 0., 1.2]</rosparam>
  </group>

</launch>
