<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="debug"       default="false"/>
  <arg name="valgrind"    default="false"/>
  <arg name="dt"          default="0.0005"/>
  <arg name="world"       default=""/>
  <arg name="ft_sensors"  default="false"/>

  <!-- upload actuator parameters -->
  <include file="$(find kangaroo_pal_physics_simulator)/launch/upload_actuator_parameters.launch"/>

  <!-- launch simulator -->
  <include file="$(find kangaroo_pal_physics_simulator)/launch/kangaroo_pal_physics_simulator.launch">
    <arg name="debug"     value="$(arg debug)"/>
    <arg name="valgrind"  value="$(arg valgrind)"/>
    <arg name="dt"        value="$(arg dt)"/>
    <arg name="world"     value="$(arg world)"/>
    <arg name="ft_sensors" value="$(arg ft_sensors)"/>
  </include>

</launch>
