<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="debug"     default="false"/>
  <arg name="valgrind"  default="false"/>

  <!-- Load Kangaroo description with no grippers -->
  <include file="$(find kangaroo_description)/robots/upload.launch">
    <arg name="enable_crane"  value="False"/> 
    <arg name="simulation"    value="False"/> 
    <arg name="fixed_base"    value="True"/> 
  </include>

  <!-- Load PIDs  && Load HAL description -->
  <include file="$(find kangaroo_pal_physics_simulator)/launch/kangaroo_pal_physics_simulator_parameters.launch">
    <arg name="pids"  value="pids_fixed_base" />
  </include>

  <!-- Launch simulation -->
  <include file="$(find pal_physics_simulator)/launch/pal_physics_simulator_parameters.launch">
    <arg name="fixed_base" value="true"/>
    <arg name="type"        value="pal_physics_simulator::KangarooPhysicsSimulator"/>
  </include>

  <include file="$(find pal_physics_simulator)/launch/pal_physics_simulator.launch">
    <arg name="debug"     value="$(arg debug)"/>
    <arg name="valgrind"  value="$(arg valgrind)"/>
  </include>

  <!-- Spawn bringup controllers -->
  <include file="$(find kangaroo_controller_configuration)/launch/bringup_controllers.launch" />

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find kangaroo_pal_physics_simulator)/config/rviz/pal_physics_simulator.rviz" />

</launch>
