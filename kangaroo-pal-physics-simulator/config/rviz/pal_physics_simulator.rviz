Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MarkerArray2
        - /MarkerArray2/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 1076
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Alpha: 1
      Class: rviz/Effort
      Enabled: false
      History Length: 1
      Joints:
        {}
      Name: Effort
      Robot Description: robot_description
      Scale: 1
      TF Prefix: ""
      Topic: /joint_states
      Unreliable: false
      Value: false
      Width: 0.019999999552965164
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /biped_walking_dcm_controller/markers
      Name: MarkerArray
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Alpha: 1
      Base State: /simulator/floating_base_state
      Class: rviz_trajectory/RobotModelRbdlDisplay
      Enabled: true
      Joint States: /simulator/joint_states
      Name: RobotModelRbdlDisplay
      Robot Description: robot_description
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /simulator/markers
      Name: MarkerArray
      Namespaces:
        collision_robot: false
        collisions_environment: false
        contact_forces: false
        contact_frame: false
        environment: true
        external_force: false
        robot: false
      Queue Size: 100
      Value: true
    - Alpha: 1
      Arrow Width: 0.5
      Class: rviz/WrenchStamped
      Enabled: false
      Force Arrow Scale: 0.00800000037997961
      Force Color: 204; 51; 51
      Hide Small Values: true
      History Length: 1
      Name: WrenchStamped (Right)
      Topic: /right_ankle_ft
      Torque Arrow Scale: 0.05000000074505806
      Torque Color: 204; 204; 51
      Unreliable: false
      Value: false
    - Alpha: 1
      Arrow Width: 0.5
      Class: rviz/WrenchStamped
      Enabled: false
      Force Arrow Scale: 0.00800000037997961
      Force Color: 204; 51; 51
      Hide Small Values: true
      History Length: 1
      Name: WrenchStamped (Left)
      Topic: /left_ankle_ft
      Torque Arrow Scale: 0.05000000074505806
      Torque Color: 204; 204; 51
      Unreliable: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Theta std deviation: 0.2617993950843811
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4.016630172729492
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.1667320877313614
        Y: -0.009060205891728401
        Z: 0.6797774434089661
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.17539837956428528
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.005435348488390446
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1385
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 2493
  X: 67
  Y: 273
