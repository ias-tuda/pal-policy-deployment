<launch>
  <!-- Board detection (annotated image for RViz) and the interactive pose teacher.
       camera: a name under cameras: in the config. -->
  <arg name="camera" default="torso_front"/>
  <arg name="config" default="$(find kangaroo_camera_calibration)/config/calibration.yaml"/>
  <arg name="rviz" default="true"/>

  <node pkg="kangaroo_camera_calibration" type="board_detector.py" name="charuco_detector" output="screen">
    <param name="config" value="$(arg config)"/>
    <param name="camera" value="$(arg camera)"/>
  </node>
  <node pkg="kangaroo_camera_calibration" type="pose_teacher.py" name="pose_teacher" output="screen">
    <param name="config" value="$(arg config)"/>
    <param name="camera" value="$(arg camera)"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="calibration_rviz"
        args="-d $(find kangaroo_camera_calibration)/rviz/calibration.rviz"/>
</launch>
