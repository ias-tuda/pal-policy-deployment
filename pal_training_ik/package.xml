<?xml version="1.0"?>
<package format="2">
  <name>pal_training_ik</name>
  <version>0.1.0</version>
  <description>ROS adapter reproducing the mjlab differential IK action used by manipulation policies.</description>

  <maintainer email="adria.roig@pal-robotics.com">PAL Robotics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>urdf</depend>
  <depend>kdl_parser</depend>
  <exec_depend>pal_gravity_compensation</exec_depend>

  <export/>
</package>
